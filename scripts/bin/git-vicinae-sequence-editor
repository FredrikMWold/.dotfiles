#!/usr/bin/env bash
set -e

FILE="$1"

vicinae "vicinae://extensions/FredrikMWold/git-editor/git-sequence?arguments={\"gitFile\":\"$FILE\"}"


# Wait until Vicinae writes to the file
inotifywait \
  --quiet \
  --event close_write,move,delete_self \
  "$FILE"

# Grace period for final flush
sleep 0.1

exit 0
