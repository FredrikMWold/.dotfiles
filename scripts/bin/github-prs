#!/bin/zsh

# Cache directory
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/github-prs"
mkdir -p "$CACHE_DIR"
CACHE_FILE="$CACHE_DIR/prs.json"

my_open_prs_repos=("equinor/prisma-decision-web" "equinor/subsurface-portal-web" "equinor/pressure-db-ingestion-web" "equinor/design-system" "equinor/warp-ui")
my_open_prs_count=0
my_open_prs_cache="[]"

for repo in "${my_open_prs_repos[@]}"; do
  prs_json=$(gh pr list --repo "$repo" --state open --search '-label:dependencies -label:"autorelease: pending" author:@me is:open' --json number,title,url)
  if [[ "$prs_json" != "[]" && -n "$prs_json" ]]; then
    repo_name="${repo#*/}"
    # Add repo name to each PR and merge into cache
    my_open_prs_cache=$(echo "$my_open_prs_cache" | jq --arg repo "$repo_name" --arg type "my" --argjson new "$prs_json" '. + ($new | map(. + {repo: $repo, type: $type}))')
    
    count=$(echo "$prs_json" | jq 'length')
    my_open_prs_count=$((my_open_prs_count + count))
  fi
done

pr_to_review_repos=("equinor/prisma-decision-web" "equinor/subsurface-portal-web" "equinor/pressure-db-ingestion-web" "equinor/warp-ui")
pr_to_review_count=0
pr_to_review_cache="[]"

for repo in "${pr_to_review_repos[@]}"; do
  prs_json=$(gh pr list --repo "$repo" --state open --search '-label:dependencies -label:"autorelease: pending" -author:@me is:open' --json number,title,url,author)
  if [[ "$prs_json" != "[]" && -n "$prs_json" ]]; then
    repo_name="${repo#*/}"
    # Add repo name to each PR and merge into cache
    pr_to_review_cache=$(echo "$pr_to_review_cache" | jq --arg repo "$repo_name" --arg type "review" --argjson new "$prs_json" '. + ($new | map(. + {repo: $repo, type: $type}))')
    
    count=$(echo "$prs_json" | jq 'length')
    pr_to_review_count=$((pr_to_review_count + count))
  fi
done

# Save combined cache
echo "$my_open_prs_cache" "$pr_to_review_cache" | jq -s 'add' > "$CACHE_FILE"

text=" my $my_open_prs_count |  review $pr_to_review_count"

# Output JSON for waybar
jq -c -n --arg text "$text" '{text: $text}'
