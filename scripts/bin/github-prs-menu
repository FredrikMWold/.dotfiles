#!/bin/zsh

# Cache file location
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/github-prs/prs.json"

# Check if cache exists
if [[ ! -f "$CACHE_FILE" ]]; then
  notify-send "GitHub PRs" "No cached data. Wait for waybar to refresh."
  exit 1
fi

# Build menu from cache
menu_options=$(jq -r '.[] | 
  if .type == "my" then
    "󰓂 \(.repo): #\(.number) \(.title)|\(.url)"
  else
    "󰓂 \(.repo): #\(.number) \(.title) (@\(.author.login))|\(.url)"
  end' "$CACHE_FILE")

# Show menu and get selection
selected=$(echo "$menu_options" | cut -d'|' -f1 | vicinae dmenu --placeholder "Select PR to open..." --no-section)

if [[ -n "$selected" ]]; then
  # Find the URL for the selected item
  url=$(echo "$menu_options" | grep -F "${selected}|" | cut -d'|' -f2)
  if [[ -n "$url" ]]; then
    google-chrome-stable "$url" 2>/dev/null &
  fi
fi
